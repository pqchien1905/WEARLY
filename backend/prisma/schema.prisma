generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  CUSTOMER
  ADMIN
  MANAGER
  WAREHOUSE
  SUPPORT
}
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}
enum ShipmentStatus {
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  DELIVERED
  RETURNED
}
enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  FAILED
  REFUNDED
  CANCELLED
}
enum RefundStatus {
  REVIEW
  PROCESSING
  SUCCEEDED
  FAILED
}
enum CouponKind {
  FIXED
  PERCENT
}
enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
}
enum AIJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
enum AdminAuditAction {
  STAFF_UPDATED
  SUPPORT_REPLIED
  SUPPORT_STATUS_CHANGED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  SKU_CREATED
  SKU_UPDATED
  CATEGORY_CREATED
  CATEGORY_RENAMED
  BRAND_CREATED
  BRAND_RENAMED
  INVENTORY_ADJUSTED
  ORDER_STATUS_CHANGED
  CONTENT_DRAFT_SAVED
  CONTENT_PUBLISHED
  PRODUCT_IMAGE_UPLOADED
  COD_SETTLED
  PROMOTION_CREATED
  PROMOTION_UPDATED
  SHIPMENT_UPDATED
  ORDER_CANCELLED
  RETURN_DECIDED
  RETURN_RECEIVED
  REFUND_CREATED
  REFUND_UPDATED
}
// Historical identifiers intentionally survive changes to the referenced entities.
// Do not copy request bodies or credentials into activity history.
model AdminAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  action AdminAuditAction
  targetId String @db.Uuid
  details Json @default("{}")
  createdAt DateTime @default(now())
  @@index([createdAt, id])
}
model StoreContent {
  id String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(30)
  banner String @db.VarChar(120)
  policy String @db.VarChar(5000)
  details Json?
  version Int @default(1)
  publishedBanner String? @db.VarChar(120)
  publishedPolicy String? @db.VarChar(5000)
  publishedDetails Json?
  publishedVersion Int?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String
  passwordChangedAt DateTime?
  name String
  phone String @default("")
  role Role @default(CUSTOMER)
  active Boolean @default(true)
  staffVersion Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  addresses Address[]
  cart Cart?
  orders Order[]
  wishlist WishlistItem[]
  reviews Review[]
  aiJobs AIJob[]
  images ImageAsset[]
  stylePreference StylePreference?
  addressCreateReceipts AddressCreateReceipt[]
}
model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique @db.VarChar(64)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
model StylePreference {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  size String
  style String
  color String
  budget Decimal @db.Decimal(14, 0)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  familyId String @db.Uuid
  browserScope String? @db.VarChar(8)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, familyId])
}
model Address {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  label String @default("Nhà")
  recipient String
  phone String
  address String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createReceipt AddressCreateReceipt?
  @@index([userId])
}
model AddressCreateReceipt {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  key String @db.VarChar(128)
  requestHash String @db.VarChar(64)
  addressId String? @unique @db.Uuid
  address Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@id([userId, key])
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
}
model Brand {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  description String
  material String
  style String
  active Boolean @default(true)
  tryOnSupported Boolean @default(false)
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id])
  brandId String @db.Uuid
  brand Brand @relation(fields: [brandId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  variants ProductVariant[]
  images ProductImage[]
  wishlist WishlistItem[]
  reviews Review[]
  @@index([active, createdAt, id])
  @@index([categoryId, active])
  @@index([brandId, active])
}
model ProductVariant {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  sku String @unique
  size String
  color String
  colorHex String
  price Decimal @db.Decimal(14, 0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]
  aiJobs AIJob[]
  @@unique([productId, size, color])
  @@index([size, color, price])
}
model ProductImage {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url String
  alt String
  color String?
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, position])
}
// Durable public catalog assets outlive gallery edits/order snapshots.
// Actor/product identifiers are historical: no cascade from account/catalog.
model CatalogAsset {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  actorId String @db.Uuid
  requestKey String @db.Uuid
  inputHash String @db.VarChar(64)
  objectKey String @unique
  sha256 String @db.VarChar(64)
  mimeType String
  size Int
  width Int
  height Int
  receipt Json?
  verifiedAt DateTime?
  deletedAt DateTime?
  purgedAt DateTime?
  purgeRetryAt DateTime?
  createdAt DateTime @default(now())
  @@unique([actorId, requestKey])
  @@index([productId])
  @@index([verifiedAt, purgeRetryAt, createdAt])
}
model Inventory {
  id String @id @default(uuid()) @db.Uuid
  variantId String @unique @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id])
  quantity Int @default(0)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movements InventoryMovement[]
}
model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid
  inventoryId String @db.Uuid
  inventory Inventory @relation(fields: [inventoryId], references: [id])
  delta Int
  reason String
  orderId String? @db.Uuid
  order Order? @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
  @@index([inventoryId, createdAt])
}
model Cart {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items CartItem[]
}
model CartItem {
  id String @id @default(uuid()) @db.Uuid
  cartId String @db.Uuid
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id])
  quantity Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([cartId, variantId])
}
model Order {
  mail MailOutbox[]
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  idempotencyKey String
  requestHash String
  status OrderStatus @default(PENDING)
  addressSnapshot Json
  subtotal Decimal @db.Decimal(14, 0)
  discount Decimal @default(0) @db.Decimal(14, 0)
  couponCode String?
  shipping Decimal @db.Decimal(14, 0)
  shippingMethod String @default("standard") @db.VarChar(20)
  total Decimal @db.Decimal(14, 0)
  currency String @default("VND")
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  payment Payment?
  redemption CouponRedemption?
  shipment Shipment?
  history OrderEvent[]
  returns ReturnRequest[]
  movements InventoryMovement[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
model OrderEvent {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status OrderStatus
  version Int
  actorId String @db.Uuid
  note String @default("") @db.VarChar(300)
  createdAt DateTime @default(now())
  @@unique([orderId, version])
}
model Shipment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier String @default("local_simulator") @db.VarChar(30)
  trackingCode String @unique @db.VarChar(50)
  status ShipmentStatus @default(IN_TRANSIT)
  events ShipmentEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ShipmentEvent {
  id String @id @default(uuid()) @db.Uuid
  shipmentId String @db.Uuid
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  eventKey String @db.Uuid
  status ShipmentStatus
  orderVersion Int
  actorId String @db.Uuid
  note String @default("") @db.VarChar(300)
  createdAt DateTime @default(now())
  @@unique([shipmentId, eventKey])
  @@unique([shipmentId, orderVersion])
}
model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id])
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id])
  name String
  sku String
  slug String
  size String
  color String
  image String
  unitPrice Decimal @db.Decimal(14, 0)
  quantity Int
  createdAt DateTime @default(now())
  returns ReturnItem[]
  @@index([orderId])
}
model ReturnRequest {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestKey String @db.Uuid
  requestHash String @db.VarChar(64)
  reason String @db.VarChar(300)
  status ReturnStatus @default(REQUESTED)
  amount Decimal @db.Decimal(14, 0)
  version Int @default(0)
  decisionNote String @default("") @db.VarChar(300)
  decidedBy String? @db.Uuid
  decidedAt DateTime?
  receiptNote String @default("") @db.VarChar(300)
  receivedBy String? @db.Uuid
  receivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items ReturnItem[]
  @@unique([orderId, requestKey])
  @@index([orderId, createdAt])
}
model ReturnItem {
  id String @id @default(uuid()) @db.Uuid
  returnId String @db.Uuid
  request ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String @db.Uuid
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity Int
  amount Decimal @db.Decimal(14, 0)
  @@unique([returnId, orderItemId])
}
model Payment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  order Order @relation(fields: [orderId], references: [id])
  provider String @default("cod")
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(14, 0)
  providerTransactionId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  settlement PaymentSettlement?
  attempts PaymentAttempt[]
  refunds Refund[]
}
model PaymentAttempt {
  id String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(32)
  paymentId String @db.Uuid
  payment Payment @relation(fields: [paymentId], references: [id])
  amount Decimal @db.Decimal(14, 0)
  status PaymentStatus @default(PENDING)
  ipAddress String @db.VarChar(45)
  transactionNo String? @unique @db.VarChar(15)
  reviewRequired Boolean @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastQueryAt DateTime?
  updatedAt DateTime @updatedAt
  refunds Refund[]
  @@index([paymentId, createdAt])
}
model Refund {
  id String @id @default(uuid()) @db.Uuid
  paymentId String @db.Uuid
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  attemptId String? @db.Uuid
  attempt PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  primary Boolean
  requestKey String @db.Uuid
  payloadHash String @db.Char(64)
  providerRequestId String @unique @db.VarChar(32)
  amount Decimal @db.Decimal(14, 0)
  status RefundStatus @default(REVIEW)
  reference String? @unique @db.VarChar(100)
  providerTransactionNo String? @unique @db.VarChar(15)
  actorId String @db.Uuid
  lastQueryAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([paymentId, requestKey])
  @@index([paymentId, createdAt])
}
model PaymentSettlement {
  id String @id @default(uuid()) @db.Uuid
  paymentId String @unique @db.Uuid
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actorId String @db.Uuid
  amount Decimal @db.Decimal(14, 0)
  reference String @db.VarChar(100)
  settledAt DateTime @default(now())
  @@index([settledAt])
}
model Coupon {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  amount Decimal @db.Decimal(14, 0)
  kind CouponKind @default(FIXED)
  active Boolean @default(false)
  startsAt DateTime?
  expiresAt DateTime?
  minSubtotal Decimal @default(0) @db.Decimal(14, 0)
  maxDiscount Decimal? @db.Decimal(14, 0)
  usageLimit Int?
  perUserLimit Int @default(1)
  version Int @default(0)
  redemptions CouponRedemption[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CouponRedemption {
  id String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  coupon Coupon @relation(fields: [couponId], references: [id])
  orderId String @unique @db.Uuid
  order Order @relation(fields: [orderId], references: [id])
  userId String @db.Uuid
  discount Decimal @db.Decimal(14, 0)
  createdAt DateTime @default(now())
  releasedAt DateTime?
  @@index([couponId, userId, releasedAt])
}
model WishlistItem {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, productId])
}
model Review {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  rating Int
  comment String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, productId])
  @@index([productId, createdAt, id])
  @@index([userId, createdAt, id])
}
model ImageAsset {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  objectKey String @unique
  mimeType String
  size Int
  width Int?
  height Int?
  sha256 String?
  consentAt DateTime?
  verifiedAt DateTime?
  deletedAt DateTime?
  purgedAt DateTime?
  purgeRetryAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs AIJob[]
  requestKey String? @db.Uuid
  @@unique([userId, requestKey])
  @@index([userId, expiresAt])
  @@index([purgedAt, expiresAt])
  @@index([purgedAt, purgeRetryAt])
}
model AIJob {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id])
  imageId String @db.Uuid
  image ImageAsset @relation(fields: [imageId], references: [id])
  status AIJobStatus @default(PENDING)
  consentAt DateTime
  errorCode String?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  result TryOnResult?
  outbox OutboxEvent?
  usageId String? @unique @db.Uuid
  usage AiUsage? @relation(fields: [usageId], references: [id], onDelete: Restrict)
  garmentRef String?
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
enum AiUsageStatus {
  RESERVED
  PROCESSING
  COMPLETED
  FAILED
  UNKNOWN
}
model AiUsage {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  kind String @db.VarChar(20)
  requestKey String @db.Uuid
  inputHash String @db.VarChar(64)
  status AiUsageStatus @default(PROCESSING)
  model String @db.VarChar(80)
  estimatedCostVnd Decimal @db.Decimal(14, 0)
  inputTokens Int?
  outputTokens Int?
  errorCode String? @db.VarChar(60)
  receipt Json?
  deadlineAt DateTime
  expiresAt DateTime
  finishedAt DateTime?
  createdAt DateTime @default(now())
  job AIJob?
  @@unique([userId, kind, requestKey])
  @@index([createdAt, kind])
  @@index([status, deadlineAt])
  @@index([expiresAt])
}
model TryOnResult {
  id String @id @default(uuid()) @db.Uuid
  jobId String @unique @db.Uuid
  job AIJob @relation(fields: [jobId], references: [id])
  objectKey String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  jobId String @unique @db.Uuid
  job AIJob @relation(fields: [jobId], references: [id])
  publishedAt DateTime?
  createdAt DateTime @default(now())
  @@index([publishedAt, createdAt])
}
enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}
enum MailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}
model SupportTicket {
  id String @id @default(uuid()) @db.Uuid
  requestKey String @unique @db.Uuid
  payloadHash String @db.Char(64)
  name String @db.VarChar(100)
  email String @db.VarChar(254)
  message String @db.VarChar(3000)
  status SupportStatus @default(OPEN)
  version Int @default(0)
  replies SupportReply[]
  mail MailOutbox[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt, id])
}
model SupportReply {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId String @db.Uuid
  requestKey String @db.Uuid
  payloadHash String @db.Char(64)
  message String @db.VarChar(3000)
  mail MailOutbox?
  createdAt DateTime @default(now())
  @@unique([ticketId, requestKey])
  @@index([ticketId, createdAt, id])
}
model MailOutbox {
  id String @id @default(uuid()) @db.Uuid
  eventKey String @unique @db.VarChar(160)
  recipient String @db.VarChar(254)
  subject String @db.VarChar(200)
  body String @db.Text
  orderId String? @db.Uuid
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supportId String? @db.Uuid
  support SupportTicket? @relation(fields: [supportId], references: [id], onDelete: Cascade)
  replyId String? @unique @db.Uuid
  reply SupportReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  status MailStatus @default(PENDING)
  attempts Int @default(0)
  leaseToken String? @db.Uuid
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  sentAt DateTime?
  lastError String? @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
  @@index([orderId, createdAt])
  @@index([supportId, createdAt])
}
