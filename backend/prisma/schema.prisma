generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  CUSTOMER
  ADMIN
}
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}
enum AIJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String
  name String
  phone String @default("")
  role Role @default(CUSTOMER)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]
  addresses Address[]
  cart Cart?
  orders Order[]
  wishlist WishlistItem[]
  reviews Review[]
  aiJobs AIJob[]
  images ImageAsset[]
  stylePreference StylePreference?
}
model StylePreference {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  size String
  style String
  color String
  budget Decimal @db.Decimal(14, 0)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  familyId String @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, familyId])
}
model Address {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  label String @default("Nhà")
  recipient String
  phone String
  address String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
}
model Brand {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  description String
  material String
  style String
  active Boolean @default(true)
  tryOnSupported Boolean @default(false)
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id])
  brandId String @db.Uuid
  brand Brand @relation(fields: [brandId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  variants ProductVariant[]
  images ProductImage[]
  wishlist WishlistItem[]
  reviews Review[]
  @@index([active, createdAt, id])
  @@index([categoryId, active])
  @@index([brandId, active])
}
model ProductVariant {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  sku String @unique
  size String
  color String
  colorHex String
  price Decimal @db.Decimal(14, 0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]
  aiJobs AIJob[]
  @@unique([productId, size, color])
  @@index([size, color, price])
}
model ProductImage {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url String
  alt String
  color String?
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, position])
}
model Inventory {
  id String @id @default(uuid()) @db.Uuid
  variantId String @unique @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id])
  quantity Int @default(0)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movements InventoryMovement[]
}
model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid
  inventoryId String @db.Uuid
  inventory Inventory @relation(fields: [inventoryId], references: [id])
  delta Int
  reason String
  orderId String? @db.Uuid
  order Order? @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
  @@index([inventoryId, createdAt])
}
model Cart {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items CartItem[]
}
model CartItem {
  id String @id @default(uuid()) @db.Uuid
  cartId String @db.Uuid
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id])
  quantity Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([cartId, variantId])
}
model Order {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  idempotencyKey String
  requestHash String
  status OrderStatus @default(PENDING)
  addressSnapshot Json
  subtotal Decimal @db.Decimal(14, 0)
  shipping Decimal @db.Decimal(14, 0)
  total Decimal @db.Decimal(14, 0)
  currency String @default("VND")
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  payment Payment?
  movements InventoryMovement[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id])
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id])
  name String
  sku String
  slug String
  size String
  color String
  image String
  unitPrice Decimal @db.Decimal(14, 0)
  quantity Int
  createdAt DateTime @default(now())
  @@index([orderId])
}
model Payment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  order Order @relation(fields: [orderId], references: [id])
  provider String @default("cod")
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(14, 0)
  providerTransactionId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Coupon {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  amount Decimal @db.Decimal(14, 0)
  active Boolean @default(false)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model WishlistItem {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, productId])
}
model Review {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  rating Int
  comment String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, productId])
  @@index([productId, createdAt, id])
  @@index([userId, createdAt, id])
}
model ImageAsset {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  objectKey String @unique
  mimeType String
  size Int
  width Int?
  height Int?
  sha256 String?
  consentAt DateTime?
  verifiedAt DateTime?
  deletedAt DateTime?
  purgedAt DateTime?
  purgeRetryAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs AIJob[]
  @@index([userId, expiresAt])
  @@index([purgedAt, expiresAt])
  @@index([purgedAt, purgeRetryAt])
}
model AIJob {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id])
  imageId String @db.Uuid
  image ImageAsset @relation(fields: [imageId], references: [id])
  status AIJobStatus @default(PENDING)
  consentAt DateTime
  errorCode String?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  result TryOnResult?
  outbox OutboxEvent?
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
model TryOnResult {
  id String @id @default(uuid()) @db.Uuid
  jobId String @unique @db.Uuid
  job AIJob @relation(fields: [jobId], references: [id])
  objectKey String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  jobId String @unique @db.Uuid
  job AIJob @relation(fields: [jobId], references: [id])
  publishedAt DateTime?
  createdAt DateTime @default(now())
  @@index([publishedAt, createdAt])
}
