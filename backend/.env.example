NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://wearly:replace-local-password@localhost:5432/wearly
POSTGRES_DB=wearly
POSTGRES_USER=wearly
POSTGRES_PASSWORD=replace-local-password
# For Windows native services plus Docker, publish containers on 5433/6380.
POSTGRES_PUBLISHED_PORT=5432
REDIS_PUBLISHED_PORT=6379
REDIS_HOST=localhost
REDIS_PORT=6379
AI_QUEUE_PREFIX=wearly
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SWAGGER_ENABLED=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wearly-private
S3_ACCESS_KEY_ID=replace-local-access-key
S3_SECRET_ACCESS_KEY=replace-local-storage-secret
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
