NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://wearly:replace-local-password@localhost:5432/wearly
POSTGRES_DB=wearly
POSTGRES_USER=wearly
POSTGRES_PASSWORD=replace-local-password
# For Windows native services plus Docker, publish containers on 5433/6380.
POSTGRES_PUBLISHED_PORT=5432
REDIS_PUBLISHED_PORT=6379
REDIS_HOST=localhost
REDIS_PORT=6379
AI_QUEUE_PREFIX=wearly
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SWAGGER_ENABLED=true
S3_ENDPOINT=http://localhost:9000
# Browser/provider-reachable URL used for signing; leave empty to use S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wearly-private
S3_ACCESS_KEY_ID=replace-local-access-key
S3_SECRET_ACCESS_KEY=replace-local-storage-secret
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
# VNPay sandbox only. Enable after supplying your sandbox merchant credentials.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/api/v1/payments/vnpay/return
VNPAY_WEB_RETURN_URL="http://localhost:5173/#/payments/return"
# Disabled until both API and worker have a verified SMTP configuration.
PASSWORD_RECOVERY_ENABLED=false
# Local order/support outbox; requires loopback SMTP and non-production mode.
LOCAL_MAIL_ENABLED=false
# Absolute SMTP deadline, including a peer that keeps sending partial replies.
LOCAL_MAIL_TIMEOUT_MS=30000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Only loopback development/test SMTP can use plaintext; forbidden in production.
SMTP_ALLOW_INSECURE_LOCAL=false
# Must match a CORS origin, use HTTPS in production, and end in /#/reset-password.
PASSWORD_RESET_WEB_URL=
